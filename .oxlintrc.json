{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": { "correctness": "warn" },
  "rules": {
    "no-debugger": "error",
    "no-unreachable": "error",
    "no-constant-binary-expression": "error"
  },
  "ignorePatterns": ["**/node_modules/**", "**/dist/**", "coverage/**"]
}
