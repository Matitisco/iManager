# Backend API base URL for Railway deployment
# Example: https://imanager-api.up.railway.app
VITE_API_BASE_URL=""

# Optional custom Firebase auth domain (hostname only). Configure OAuth/proxy first.
# See docs/pwa-auth-domain.md. Empty preserves the existing login.
VITE_FIREBASE_AUTH_DOMAIN=""

# Solo para el proceso backend (Railway); nunca prefijar con VITE_ ni exponer al navegador.
# Ver backend/.env.example y docs/subscriptions-359.md.
MP_ACCESS_TOKEN=
# Correos del panel interno /admin/actividad. Vacío y sin un correo real. Ver backend/.env.example.
ADMIN_EMAILS=
MP_WEBHOOK_SECRET=
