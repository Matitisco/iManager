{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node scripts/serve-spa.mjs",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "npm run test:frontend",
    "test:frontend": "vitest run",
    "test:frontend:coverage": "vitest run --coverage",
    "test:backend:unit": "npm --prefix backend run test:unit",
    "test:backend:integration": "npm --prefix backend run test:integration",
    "test:backend:coverage": "npm --prefix backend run test:coverage",
    "test:e2e": "playwright test",
    "test:pwa": "node scripts/pwa.test.mjs",
    "test:pwa:e2e": "playwright test --config playwright.pwa.config.ts",
    "test:ci": "npm run test:frontend && npm run test:backend:unit && npm run test:backend:integration && npm run test:e2e",
    "build:imei-tac": "node scripts/build-imei-tac.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "@zxing/browser": "^0.2.1",
    "exceljs": "^4.4.0",
    "firebase": "^12.10.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "posthog-js": "^1.438.23",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.53.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.12",
    "jsdom": "^29.0.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.15",
    "typescript": "~5.8.2",
    "vite": "^6.4.4",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "protobufjs": "7.6.6",
    "@firebase/firestore": {
      "@grpc/grpc-js": "~1.13.7"
    },
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
