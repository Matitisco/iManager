{
  "name": "imanager-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "prisma db execute --file prisma/pre-push.sql --schema prisma/schema.prisma && prisma db push && npm run billing:sync:start && (timeout 280 node dist/scripts/test-job-agrupar.js || true) && node dist/src/server.js",
    "lint": "tsc --noEmit",
    "test": "npm run test:unit",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:coverage": "vitest run --config vitest.unit.config.ts --coverage",
    "bootstrap:owner": "tsx scripts/bootstrap-owner.ts",
    "migrate:clients": "tsx scripts/migrate-clients.ts",
    "prisma:generate": "prisma generate",
    "prisma:deploy": "prisma migrate deploy",
    "eval:import": "tsx scripts/eval-import-llm.ts",
    "billing:sync": "tsx scripts/billing-sync.ts",
    "billing:sync:start": "timeout 90 node dist/scripts/billing-sync.js || echo 'Aviso: la sincronización de facturación falló; la API arranca igual.'",
    "reports:send": "tsx scripts/periodic-reports.ts",
    "agrupar:repetidos": "node dist/scripts/agrupar-repetidos.js",
    "agrupar:seed": "node dist/scripts/seed-agrupar.js"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/sensible": "^6.0.3",
    "@prisma/client": "^6.6.0",
    "fastify": "^5.12.7",
    "firebase-admin": "^13.10.0",
    "nodemailer": "^10.1.7",
    "sharp": "^0.35.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.2",
    "@vitest/coverage-v8": "^4.1.12",
    "exceljs": "^4.4.0",
    "prisma": "^6.6.0",
    "tsx": "^4.23.15",
    "typescript": "^5.8.2",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "protobufjs": "7.6.6",
    "gaxios": {
      "uuid": "11.1.1"
    },
    "google-gax": {
      "uuid": "11.1.1"
    },
    "teeny-request": {
      "uuid": "11.1.1"
    },
    "@prisma/config@6.19.3": {
      "deepmerge-ts": "8.0.2"
    }
  }
}
