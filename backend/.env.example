PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/imanager
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIRESTORE_DATABASE_ID=

# Análisis de planillas al importar. La clave no va al frontend.
# OPENAI_IMPORT_MODEL default: gpt-6-luna (POST /v1/responses, structured outputs).
OPENAI_API_KEY=
OPENAI_IMPORT_MODEL=

# Suscripciones Mercado Pago: solo backend / Railway. Comenzar con vendedor TEST.
MP_ACCESS_TOKEN=
# Obligatorio en producción: sin secreto el webhook responde 401.
MP_WEBHOOK_SECRET=
