PORT=3000
NODE_ENV=development

# Development DB. Keep production DATABASE_URL only in Railway/project secrets.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/imanager_dev

# Frontend host that will consume this backend in development
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Shared Firebase Auth for now (temporary until the split auth iteration)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIRESTORE_DATABASE_ID=

# Optional email/2FA configuration
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
