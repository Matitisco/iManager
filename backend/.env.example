PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/imanager
# Public origin of THIS frontend. Invitation links are built from it.
# A preview service that shares the production database must set its own
# FRONTEND_URL (the preview URL). Do not point it at production if the
# links should open the preview.
FRONTEND_URL=http://localhost:5173
# Comma-separated browser origins allowed to call this API.
# Add the preview frontend origin here when the API is shared.
CORS_ALLOWED_ORIGINS=http://localhost:5173

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIRESTORE_DATABASE_ID=
