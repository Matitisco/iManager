generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String        @id @default(cuid())
  firebaseUid       String        @unique
  email             String?       @db.VarChar(255)
  displayName       String?       @db.VarChar(255)
  avatarUrl         String?       @db.Text
  status            UserStatus    @default(ACTIVE)
  twoFactorEnabled  Boolean       @default(false)
  twoFactorCode     String?       @db.VarChar(6)
  twoFactorExpiry   DateTime?
  memberships       StoreMember[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model Store {
  id                  String               @id @default(cuid())
  name                String               @db.VarChar(120)
  legalName           String?              @db.VarChar(160)
  taxId               String?              @db.VarChar(50)
  phone               String?              @db.VarChar(50)
  address             String?              @db.VarChar(255)
  currency            String               @default("ARS") @db.VarChar(10)
  timezone            String               @default("America/Argentina/Buenos_Aires") @db.VarChar(80)
  memberships         StoreMember[]
  invitations         StoreInvitation[]
  clients             Client[]
  clientCategories    ClientCategory[]
  inventory           InventoryItem[]
  inventoryCategories InventoryCategory[]
  saleCategories      SaleCategory[]
  sales               Sale[]
  tradeIns            TradeIn[]
  tradeInCategories   TradeInCategory[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model StoreMember {
  id        String    @id @default(cuid())
  storeId   String
  userId    String
  role      StoreRole
  isDefault Boolean   @default(false)
  store     Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([storeId, userId])
}

model Client {
  id             String          @id @default(cuid())
  storeId        String
  categoryId     String?
  dni            String          @db.VarChar(50)
  name           String          @db.VarChar(120)
  email          String?         @db.VarChar(255)
  phone          String?         @db.VarChar(50)
  lastPurchaseAt DateTime?
  totalSpent     Decimal         @default(0) @db.Decimal(12, 2)
  pendingBalance Decimal         @default(0) @db.Decimal(12, 2)
  customFields   Json?
  store          Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category       ClientCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  sales          Sale[]
  tradeIns       TradeIn[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([storeId])
  @@unique([storeId, dni])
}

model ClientCategory {
  id        String   @id @default(cuid())
  storeId   String
  name      String   @db.VarChar(80)
  sortOrder Int      @default(0)
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  clients   Client[]
  createdAt DateTime @default(now())

  @@index([storeId])
  @@unique([storeId, name])
}

model InventoryCategory {
  id        String          @id @default(cuid())
  storeId   String
  name      String          @db.VarChar(80)
  sortOrder Int             @default(0)
  store     Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  items     InventoryItem[]
  createdAt DateTime        @default(now())

  @@index([storeId])
  @@unique([storeId, name])
}

model InventoryItem {
  id            String             @id @default(cuid())
  storeId       String
  categoryId    String?
  imei          String             @db.VarChar(100)
  model         String             @db.VarChar(100)
  capacity      String             @db.VarChar(50)
  color         String             @db.VarChar(50)
  condition     String             @db.VarChar(20)
  grade         String             @db.VarChar(20)
  batteryHealth String             @db.VarChar(50)
  cost          Decimal            @db.Decimal(12, 2)
  price         Decimal            @db.Decimal(12, 2)
  status        String             @db.VarChar(20)
  customFields  Json?
  store         Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category      InventoryCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  sales         Sale[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([storeId])
  @@unique([storeId, imei])
}

model Sale {
  id              String         @id @default(cuid())
  saleNumber      Int            @default(autoincrement())
  storeId         String
  clientId        String?
  categoryId      String?
  inventoryItemId String?
  dateLabel       String         @db.VarChar(120)
  amount          Decimal        @db.Decimal(12, 2)
  paymentMethod   String         @db.VarChar(50)
  status          String         @db.VarChar(20)
  customFields    Json?
  soldAt          DateTime
  store           Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  client          Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  category        SaleCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([storeId])
  @@index([storeId, soldAt])
  @@index([clientId])
  @@index([inventoryItemId])
}

model TradeIn {
  id                 String           @id @default(cuid())
  storeId            String
  clientId           String?
  categoryId         String?
  dateLabel          String           @db.VarChar(120)
  deviceReceived     String           @db.VarChar(120)
  deviceReceivedImei String           @db.VarChar(100)
  takeValue          Decimal          @db.Decimal(12, 2)
  deviceGiven        String           @db.VarChar(120)
  differencePaid     Decimal          @db.Decimal(12, 2)
  status             String           @db.VarChar(30)
  batteryHealth      String?          @db.VarChar(50)
  grade              String?          @db.VarChar(20)
  customFields       Json?
  tradeAt            DateTime
  store              Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  client             Client?          @relation(fields: [clientId], references: [id], onDelete: SetNull)
  category           TradeInCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([storeId])
  @@index([storeId, tradeAt])
  @@index([clientId])
}

model TradeInCategory {
  id        String    @id @default(cuid())
  storeId   String
  name      String    @db.VarChar(80)
  sortOrder Int       @default(0)
  store     Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  tradeIns  TradeIn[]
  createdAt DateTime  @default(now())

  @@index([storeId])
  @@unique([storeId, name])
}

model SaleCategory {
  id        String   @id @default(cuid())
  storeId   String
  name      String   @db.VarChar(80)
  sortOrder Int      @default(0)
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  sales     Sale[]
  createdAt DateTime @default(now())

  @@index([storeId])
  @@unique([storeId, name])
}

model StoreInvitation {
  id        String           @id @default(cuid())
  storeId   String
  token     String           @unique @default(uuid())
  email     String?          @db.VarChar(255)
  role      StoreRole
  status    InvitationStatus @default(PENDING)
  expiresAt DateTime
  store     Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([storeId])
  @@index([token])
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum StoreRole {
  OWNER
  MANAGER @map("ADMIN")
  STAFF   @map("SELLER")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}

