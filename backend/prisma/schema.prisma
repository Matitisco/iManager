generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  // db push backfills existing accounts; only new auth registrations write false.
  billingLegacy Boolean @default(true)
  id                String        @id @default(cuid())
  firebaseUid       String        @unique
  email             String?       @db.VarChar(255)
  displayName       String?       @db.VarChar(255)
  avatarUrl         String?       @db.Text
  status            UserStatus    @default(ACTIVE)
  twoFactorEnabled  Boolean       @default(false)
  twoFactorCode     String?       @db.VarChar(6)
  twoFactorExpiry   DateTime?
  memberships       StoreMember[]
  notificationReads NotificationRead[]
  sectionRecordViews SectionRecordView[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model Store {
  productEvents ProductEvent[]
  // Existing stores remain internal for life, including plain db push deploys.
  billingPlan             String    @default("INTERNAL") @db.VarChar(16)
  billingStatus           String    @default("ACTIVE") @db.VarChar(16)
  trialEndsAt             DateTime?
  billingPaidThrough      DateTime?
  billingPreapprovalId    String?   @db.VarChar(100)
  billingPeriod           String?   @db.VarChar(16)
  billingPayerEmail       String?   @db.VarChar(255)
  billingRemoteUpdatedAt  DateTime?
  billingCheckouts        BillingCheckout[]
  // Null dates keep existing stores out of the new-account journey.
  onboardingStage       String?   @db.VarChar(16)
  onboardingStartedAt   DateTime?
  onboardingCompletedAt DateTime?
  id                  String               @id @default(cuid())
  name                String               @db.VarChar(120)
  legalName           String?              @db.VarChar(160)
  taxId               String?              @db.VarChar(50)
  phone               String?              @db.VarChar(50)
  email               String?              @db.VarChar(255)
  instagram           String?              @db.VarChar(60)
  address             String?              @db.VarChar(255)
  currency            String               @default("ARS") @db.VarChar(10)
  exchangeMode        String               @default("auto") @db.VarChar(10)
  exchangeSource      String               @default("blue") @db.VarChar(16)
  manualBuy           Decimal?             @db.Decimal(12, 2)
  manualSell          Decimal?             @db.Decimal(12, 2)
  timezone            String               @default("America/Argentina/Buenos_Aires") @db.VarChar(80)
  // Days prefilled on a new sale or repair. Existing rows receive the default; past sales stay without a warranty.
  usedWarrantyDays   Int                  @default(30)
  sealedWarrantyDays Int                  @default(90)
  repairWarrantyDays Int                  @default(30)
  memberships         StoreMember[]
  invitations         StoreInvitation[]
  clients             Client[]
  clientCategories    ClientCategory[]
  publicCatalog       StorePublicCatalog?
  inventory           InventoryItem[]
  inventoryCategories InventoryCategory[]
  saleCategories      SaleCategory[]
  sales               Sale[]
  tradeIns            TradeIn[]
  tradeInCategories   TradeInCategory[]
  catalogOptions      StoreCatalogOption[]
  clientPayments      ClientPayment[]
  clientDeposits      ClientDeposit[]
  notifications       StoreNotification[]
  sectionRecordViews  SectionRecordView[]
  auditEvents         AuditEvent[]
  storeCounter        StoreCounter?
  commissionRules     CommissionRule[]
  commissionPayments  CommissionPayment[]
  commissionAccruals  CommissionAccrual[]
  repairOrders        RepairOrder[]
  saleTenders         SaleTender[]
  installmentPlans    SaleInstallmentPlan[]
  installments        SaleInstallment[]
  cashRegisters       CashRegister[]
  cashSessions        CashSession[]
  cashMovements       CashMovement[]
  cashCounts          CashCount[]
  followUpSettings    StoreFollowUpSettings?
  periodicReportSettings PeriodicReportSettings?
  reportDeliveries PeriodicReportDelivery[]
  suppliers           Supplier[]
  stockPurchases      StockPurchase[]
  expenses            Expense[]
  returnCases         ReturnCase[]
  creditNotes         CreditNote[]
  creditApplications  CreditNoteApplication[]
  stockCounts         StockCount[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model StoreMember {
  gettingStartedDismissed Boolean @default(false)
  gettingStartedVisible   Boolean @default(false)
  welcomeVideoWatched      Boolean @default(false)
  appInstalled            Boolean @default(false)
  id        String    @id @default(cuid())
  storeId   String
  userId    String
  role            StoreRole
  sellerSales     Sale[]
  commissionRules CommissionRule[]
  commissionPayments CommissionPayment[]
  commissionAccruals CommissionAccrual[]
  isDefault       Boolean   @default(false)
  sections        Json?
  sensitiveAccess Boolean?
  removedAt       DateTime?
  removedBy       String?   @db.VarChar(255)
  store     Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([storeId, userId])
}

model Client {
  id             String          @id @default(cuid())
  storeId        String
  categoryId     String?
  dni            String?         @db.VarChar(50)
  name           String          @db.VarChar(120)
  email          String?         @db.VarChar(255)
  phone          String?         @db.VarChar(50)
  instagram      String?         @db.VarChar(80)
  lastPurchaseAt DateTime?
  totalSpent     Decimal         @default(0) @db.Decimal(12, 2)
  // Opening purchase history from Excel, independent of mutable sales totals.
  importedSpent  Decimal?        @db.Decimal(12, 2)
  importedSpentCurrency String?  @db.VarChar(3)
  pendingBalance Decimal         @default(0) @db.Decimal(12, 2)
  // Null means the stored totals are read in the store currency of the moment.
  balanceCurrency String?        @db.VarChar(3)
  tag            String?         @db.VarChar(30)
  birthday       DateTime?
  archivedAt     DateTime?
  archivedBy     String?         @db.VarChar(255)
  customFields   Json?
  store          Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category       ClientCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  sales          Sale[]
  tradeIns       TradeIn[]
  payments       ClientPayment[]
  deposits       ClientDeposit[]
  repairOrders   RepairOrder[]
  installmentPlans SaleInstallmentPlan[]
  returnCases    ReturnCase[]
  creditNotes    CreditNote[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([storeId])
  @@index([storeId, archivedAt])
  @@index([storeId, archivedAt, createdAt])
  @@unique([storeId, dni])
}

model ClientCategory {
  id        String   @id @default(cuid())
  storeId   String
  name      String   @db.VarChar(80)
  sortOrder Int      @default(0)
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  clients   Client[]
  archivedAt DateTime?
  createdAt DateTime @default(now())

  @@index([storeId])
  @@unique([storeId, name])
}

model InventoryCategory {
  id        String          @id @default(cuid())
  storeId   String
  name      String          @db.VarChar(80)
  sortOrder Int             @default(0)
  store     Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  items     InventoryItem[]
  archivedAt DateTime?
  createdAt DateTime        @default(now())

  @@index([storeId])
  @@unique([storeId, name])
}

model InventoryItem {
  // Server-managed provenance; never accepted by inventory create/import/update.
  sampleBatchId String? @db.VarChar(80)
  catalogVisible Boolean @default(false)
  id            String             @id @default(cuid())
  storeId       String
  categoryId    String?
  imei          String?            @db.VarChar(100)
  model         String             @db.VarChar(100)
  capacity      String             @db.VarChar(50)
  color         String             @db.VarChar(50)
  condition     String             @db.VarChar(20)
  // Cosmetic quality of a used device: A+, A, B or C. Empty when the device is not used or quality was not set.
  // This is the only quality column; the desk calls it «Calidad» and does not add a second field.
  grade         String             @db.VarChar(20)
  batteryHealth String             @db.VarChar(50)
  cost          Decimal            @db.Decimal(12, 2)
  price         Decimal?           @db.Decimal(12, 2)
  // Null on rows created before currency tracking: interpret as the current store currency.
  currency      String?            @db.VarChar(3)
  // The desk UI no longer edits quantity, but production rows still store it.
  quantity      Int                @default(1)
  status        String             @db.VarChar(20)
  archivedAt    DateTime?
  archivedBy    String?            @db.VarChar(255)
  archiveReason String?            @db.VarChar(280)
  pendingSaleRegistration Boolean  @default(false)
  // Sale of a device that was not in stock. Battery, cost and quality still need to be filled in.
  needsCompletion Boolean          @default(false)
  // One item per deposit is enforced in the deposits service transaction, not with a unique constraint.
  reservedDepositId String?
  reservedClientId String?
  reservedClientName String?      @db.VarChar(120)
  reservedAt    DateTime?
  previousSaleStatus String?       @db.VarChar(20)
  priceChangedBy String?          @db.VarChar(255)
  priceChangedAt DateTime?
  costChangedBy  String?          @db.VarChar(255)
  costChangedAt  DateTime?
  // Origin of a stock purchase. Null on rows loaded before suppliers existed.
  supplierId      String?
  stockPurchaseId String?
  supplier        Supplier?      @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  stockPurchase   StockPurchase? @relation(fields: [stockPurchaseId], references: [id], onDelete: SetNull)
  customFields  Json?
  store         Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category      InventoryCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  sales         Sale[]
  receivedTradeIns TradeIn[]       @relation("ReceivedInventory")
  returnCases   ReturnCase[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([storeId])
  @@index([storeId, archivedAt])
  @@index([storeId, archivedAt, createdAt])
  @@index([storeId, catalogVisible])
  @@index([reservedDepositId])
  @@index([supplierId])
  @@index([stockPurchaseId])
  @@unique([storeId, imei])
}

// Last issued receipt number per store. Existing Sale/TradeIn numbers stay as they are;
// the next document continues after the highest number that store already issued.
model StoreCounter {
  storeId         String @id
  lastSaleNumber  Int    @default(0)
  lastTradeNumber Int    @default(0)
  lastRepairNumber Int   @default(0)
  store           Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
}

model Sale {
  id              String         @id @default(cuid())
  sellerMemberId  String?
  registeredByUserId String?
  exchangeRate    Decimal?       @db.Decimal(12, 2)
  sellerMember    StoreMember?   @relation(fields: [sellerMemberId], references: [id], onDelete: SetNull)
  saleNumber      Int            @default(autoincrement())
  storeId         String
  clientId        String?
  clientName      String         @default("") @db.VarChar(120)
  categoryId      String?
  inventoryItemId String?
  tradeInId       String?        @unique
  requestKey      String?        @db.VarChar(120)
  integratedOperation Boolean    @default(false)
  previousInventoryStatus String? @db.VarChar(20)
  previousPendingSaleRegistration Boolean?
  deviceLabel     String?        @db.VarChar(120)
  dateLabel       String         @db.VarChar(120)
  depositAppliedAmount Decimal   @default(0) @db.Decimal(12, 2)
  amount          Decimal        @db.Decimal(12, 2)
  amountCurrency  String?        @db.VarChar(3)
  paymentMethod   String         @db.VarChar(50)
  status          String         @db.VarChar(20)
  // Null on sales created before warranties. The end date is soldAt plus these days, so editing the sale date moves it.
  warrantyDays    Int?
  cancelledBy     String?        @db.VarChar(255)
  cancelledAt     DateTime?
  voidedAt        DateTime?
  voidedBy        String?        @db.VarChar(255)
  voidReason      String?        @db.VarChar(280)
  // Unpaid remainder after a price increase, partial tender or installment plan. Null keeps the legacy rule: a pending sale owes its full amount.
  openBalance     Decimal?       @db.Decimal(12, 2)
  customFields    Json?
  tenders         SaleTender[]
  installmentPlans SaleInstallmentPlan[]
  returnCases     ReturnCase[]
  creditApplications CreditNoteApplication[]
  soldAt          DateTime
  store           Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  client          Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  category        SaleCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)
  tradeIn         TradeIn?       @relation(fields: [tradeInId], references: [id], onDelete: SetNull)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([storeId])
  @@index([storeId, soldAt])
  @@index([storeId, voidedAt])
  @@index([storeId, voidedAt, soldAt])
  @@index([sellerMemberId])
  @@index([clientId])
  @@index([inventoryItemId])
  @@index([inventoryItemId, soldAt])
  @@unique([storeId, requestKey])
}

model TradeIn {
  id                 String           @id @default(cuid())
  tradeNumber        Int              @default(autoincrement())
  storeId            String
  clientId           String?
  clientName         String           @default("") @db.VarChar(120)
  categoryId         String?
  dateLabel          String           @db.VarChar(120)
  deviceReceived     String           @db.VarChar(120)
  deviceReceivedImei String?          @db.VarChar(100)
  takeValue          Decimal          @db.Decimal(12, 2)
  currency           String?          @db.VarChar(3)
  deviceGiven        String           @default("") @db.VarChar(120)
  differencePaid     Decimal          @db.Decimal(12, 2)
  status             String           @db.VarChar(30)
  batteryHealth      String?          @db.VarChar(50)
  // Cosmetic quality of the received used device (A+, A, B or C). Null when unset. Same concept as InventoryItem.grade.
  grade              String?          @db.VarChar(20)
  confirmationStatus TradeInConfirmationStatus?
  // Historical sale number when the trade-in was removed from an active sale.
  removedFromSaleNumber Int?
  receivedInventoryItemId String?
  previousOutgoingStatus String?      @db.VarChar(20)
  previousOutgoingPendingRegistration Boolean?
  requestKey         String?          @db.VarChar(120)
  operationSource    String?          @db.VarChar(20)
  draftProductId     String?          @db.VarChar(120)
  draftDeviceLabel   String?          @db.VarChar(120)
  draftSaleCategoryId String?         @db.VarChar(120)
  draftAmount        Decimal?         @db.Decimal(12, 2)
  draftPaymentMethod String?          @db.VarChar(50)
  draftPaymentStatus String?          @db.VarChar(20)
  draftSellerMemberId String?         @db.VarChar(120)
  draftWarrantyDays   Int?
  cancelledBy        String?          @db.VarChar(255)
  cancelledAt        DateTime?
  voidedAt           DateTime?
  voidedBy           String?          @db.VarChar(255)
  voidReason         String?          @db.VarChar(280)
  customFields       Json?
  tradeAt            DateTime
  store              Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  client             Client?          @relation(fields: [clientId], references: [id], onDelete: SetNull)
  category           TradeInCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  receivedInventoryItem InventoryItem? @relation("ReceivedInventory", fields: [receivedInventoryItemId], references: [id], onDelete: SetNull)
  sale               Sale?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([storeId])
  @@index([storeId, tradeAt])
  @@index([storeId, voidedAt])
  @@index([storeId, voidedAt, tradeAt])
  @@index([clientId])
  @@unique([storeId, requestKey])
}

enum TradeInConfirmationStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model AuditEvent {
  id          String   @id @default(cuid())
  storeId     String
  actorUserId String?
  actorName   String   @db.VarChar(255)
  action      String   @db.VarChar(40)
  entityType  String   @db.VarChar(40)
  entityId    String   @db.VarChar(120)
  detail      String?  @db.Text
  entityLabel String?  @db.VarChar(160)
  changes     Json?
  reason      String?  @db.VarChar(280)
  actorRole   String?  @db.VarChar(20)
  source      String?  @db.VarChar(16)
  createdAt   DateTime @default(now())
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, entityType, entityId])
  @@index([storeId, createdAt])
  @@index([storeId, actorUserId, createdAt])
  @@index([storeId, action, createdAt])
}

model StoreNotification {
  id        String   @id @default(cuid())
  storeId   String
  section   String   @db.VarChar(30)
  title     String   @db.VarChar(160)
  message   String   @db.Text
  recordId  String?  @db.VarChar(120)
  targets   Json?
  kind      String   @db.VarChar(40)
  createdAt DateTime @default(now())
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  reads     NotificationRead[]

  @@index([storeId, section, createdAt])
}

model NotificationRead {
  id             String            @id @default(cuid())
  notificationId String
  userId         String
  readAt         DateTime           @default(now())
  notification   StoreNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@index([userId])
}

model TradeInCategory {
  id        String    @id @default(cuid())
  storeId   String
  name      String    @db.VarChar(80)
  sortOrder Int       @default(0)
  store     Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  tradeIns  TradeIn[]
  archivedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([storeId])
  @@unique([storeId, name])
}

model SaleCategory {
  id        String   @id @default(cuid())
  storeId   String
  name      String   @db.VarChar(80)
  sortOrder Int      @default(0)
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  sales     Sale[]
  archivedAt DateTime?
  createdAt DateTime @default(now())

  @@index([storeId])
  @@unique([storeId, name])
}

enum CatalogKind {
  INVENTORY_STATUS
  INVENTORY_CAPACITY
  INVENTORY_CONDITION
  SALE_STATUS
  TRADE_IN_STATUS
  CLIENT_TAG
  REPAIR_STATUS
}

model RepairOrder {
  id                String              @id @default(cuid())
  orderNumber       Int                 @default(autoincrement())
  storeId           String
  clientId          String?
  // Null when the order has no client. Dropping NOT NULL keeps every existing name.
  clientName        String?             @db.VarChar(120)
  device            String              @db.VarChar(120)
  imei              String              @default("") @db.VarChar(20)
  fault             String              @default("") @db.Text
  faultTags         String              @default("") @db.Text
  estimate          Decimal?            @db.Decimal(12, 2)
  deposit           Decimal             @default(0) @db.Decimal(12, 2)
  currency          String?             @db.VarChar(3)
  technician        String              @default("") @db.VarChar(120)
  status            String              @default("RECIBIDO") @db.VarChar(40)
  archivedAt        DateTime?
  archivedBy        String?             @db.VarChar(255)
  archiveReason     String?             @db.VarChar(280)
  // Null on orders created before warranties. Coverage starts when the order is delivered.
  warrantyDays      Int?
  estimatedDelivery DateTime?
  notifyWhatsapp    Boolean             @default(false)
  receivedAt        DateTime            @default(now())
  store             Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  client            Client?             @relation(fields: [clientId], references: [id], onDelete: SetNull)
  events            RepairStatusEvent[]
  accountPayments   ClientPayment[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([storeId])
  @@index([storeId, status])
  @@index([storeId, archivedAt])
  @@index([clientId])
}

model RepairStatusEvent {
  id        String      @id @default(cuid())
  storeId   String
  orderId   String
  status    String      @db.VarChar(40)
  order     RepairOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@index([storeId])
  @@index([orderId, createdAt])
}

model ClientPayment {
  id        String   @id @default(cuid())
  storeId   String
  clientId  String
  amount    Decimal  @db.Decimal(12, 2)
  currency  String?  @db.VarChar(3)
  method    String   @db.VarChar(50)
  // PAGO keeps the collection. DEVOLUCION records cash given back when a sale or trade is cancelled.
  kind      String   @default("PAGO") @db.VarChar(20)
  paidAt    DateTime @default(now())
  note      String?  @db.VarChar(200)
  // Reference kept after the sale row is deleted, so a collection or a refund stays tied to that sale.
  saleId    String?
  repairOrderId String?
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  repairOrder RepairOrder? @relation(fields: [repairOrderId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([storeId])
  @@index([clientId])
  @@index([saleId])
  @@index([repairOrderId])
}

model StoreCatalogOption {
  id        String      @id @default(cuid())
  storeId   String
  kind      CatalogKind
  value     String      @db.VarChar(30)
  label     String      @db.VarChar(20)
  color     String?     @db.VarChar(9)
  isSystem  Boolean     @default(false)
  sortOrder Int         @default(0)
  archivedAt DateTime?
  store     Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([storeId, kind, value])
  @@index([storeId, kind])
}

model StoreInvitation {
  id              String           @id @default(cuid())
  invitedById     String? // Nullable for legacy invitations; User id of the creator.
  storeId         String
  token           String           @unique @default(uuid())
  email           String?          @db.VarChar(255)
  role            StoreRole
  status          InvitationStatus @default(PENDING)
  expiresAt       DateTime
  sections        Json?
  sensitiveAccess Boolean?
  store           Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([storeId])
  @@index([token])
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum StoreRole {
  OWNER
  MANAGER @map("ADMIN")
  STAFF   @map("SELLER")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}


enum CommissionBasis {
  PROFIT_PERCENT
  SALE_PERCENT
  FIXED_PER_UNIT
}

model CommissionRule {
  active        Boolean         @default(true)
  deletedAt     DateTime?
  id            String          @id @default(cuid())
  storeId       String
  memberId      String?
  basis         CommissionBasis @default(PROFIT_PERCENT)
  rate          Decimal         @db.Decimal(12, 4)
  currency      String?         @db.VarChar(3)
  effectiveFrom DateTime
  createdBy     String
  createdAt     DateTime        @default(now())
  store         Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  member        StoreMember?    @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([storeId, memberId, effectiveFrom])
}

model CommissionPayment {
  voidedAt        DateTime?
  voidedBy        String?
  id              String      @id @default(cuid())
  storeId         String
  memberId        String
  period          String      @db.VarChar(7)
  amount          Decimal     @db.Decimal(12, 2)
  currency        String      @db.VarChar(3)
  exchangeRate    Decimal     @db.Decimal(12, 2)
  settlesCurrency String      @db.VarChar(3)
  note            String?     @db.Text
  createdBy       String
  createdAt       DateTime    @default(now())
  store           Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  member          StoreMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([storeId, memberId, period])
}

// Frozen calculation, including tombstones for physically deleted sales.
model CommissionAccrual {
  id               String           @id @default(cuid())
  storeId          String
  memberId         String
  sourceSaleId     String
  saleNumber       Int
  soldAt           DateTime
  period           String           @db.VarChar(7)
  deviceLabel      String           @db.VarChar(120)
  currency         String           @db.VarChar(3)
  exchangeRate     Decimal?         @db.Decimal(12, 2)
  total            Decimal          @db.Decimal(12, 2)
  cost             Decimal          @db.Decimal(12, 2)
  takeValue        Decimal          @db.Decimal(12, 2)
  grossProfit      Decimal          @db.Decimal(12, 2)
  commission       Decimal          @db.Decimal(12, 2)
  ruleId           String?
  basis            CommissionBasis?
  rate             Decimal?         @db.Decimal(12, 4)
  ruleCurrency     String?          @db.VarChar(3)
  voidedAt         DateTime?
  voidReason       String?          @db.VarChar(20)
  adjustmentPeriod String?          @db.VarChar(7)
  createdAt        DateTime         @default(now())
  store            Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  member           StoreMember      @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([storeId, sourceSaleId])
  @@index([storeId, memberId, period])
}

// Public sharing is opt-in. No existing inventory is published by migration.
model StorePublicCatalog {
  storeId      String @id
  slug         String @unique @db.VarChar(160)
  active       Boolean @default(false)
  hideWithoutStock Boolean @default(true)
  hideReserved Boolean @default(true)
  minBattery   Int?
  showPrice    Boolean @default(true)
  priceCurrency String @default("ORIGINAL") @db.VarChar(10)
  logoUrl      String? @db.VarChar(2000)
  hours        String? @db.VarChar(120)
  store        Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Immutable receipt amounts; applications and refunds never create a second collection.
model ClientDeposit {
  id            String   @id @default(cuid())
  storeId       String
  clientId      String
  requestKey    String   @db.VarChar(120)
  amount        Decimal  @db.Decimal(12, 2)
  currency      String   @db.VarChar(3)
  exchangeRate  Decimal  @db.Decimal(12, 2)
  usdAmount     Decimal  @db.Decimal(12, 2)
  method        String   @db.VarChar(50)
  status        String   @default("ACTIVE") @db.VarChar(20)
  productId     String?
  productLabel  String?  @db.VarChar(200)
  previousInventoryStatus String? @db.VarChar(20)
  saleId        String?
  repairId      String?
  appliedAmount Decimal? @db.Decimal(12, 2)
  appliedCurrency String? @db.VarChar(3)
  appliedAt     DateTime?
  cancelledAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  store         Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Restrict)

  @@index([storeId, clientId, status])
  @@index([storeId, saleId])
  @@index([storeId, repairId])
  @@unique([storeId, requestKey])
}

// One row per payment instrument on a sale. Several rows are a mixed payment. No unique key: a sale can repeat the same method.
model SaleTender {
  id           String   @id @default(cuid())
  storeId      String
  saleId       String
  clientId     String?
  amount       Decimal  @db.Decimal(12, 2)
  currency     String   @db.VarChar(3)
  exchangeRate Decimal? @db.Decimal(12, 2)
  method       String   @db.VarChar(50)
  role         String   @default("COBRO") @db.VarChar(20)
  createdAt    DateTime @default(now())
  store        Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  sale         Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([saleId])
}

model SaleInstallmentPlan {
  id             String   @id @default(cuid())
  storeId        String
  saleId         String
  clientId       String
  count          Int
  frequency      String   @db.VarChar(20)
  firstDueDate   DateTime
  surcharge      Decimal  @default(0) @db.Decimal(12, 2)
  financedAmount Decimal  @db.Decimal(12, 2)
  currency       String?  @db.VarChar(3)
  createdAt      DateTime @default(now())
  store          Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  sale           Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  client         Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  installments   SaleInstallment[]

  @@index([storeId])
  @@index([saleId])
  @@index([clientId])
}

model SaleInstallment {
  id         String   @id @default(cuid())
  storeId    String
  planId     String
  saleId     String
  clientId   String
  sequence   Int
  dueDate    DateTime
  amount     Decimal  @db.Decimal(12, 2)
  paidAmount Decimal  @default(0) @db.Decimal(12, 2)
  currency   String?  @db.VarChar(3)
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  plan       SaleInstallmentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([saleId])
  @@index([planId])
  @@index([clientId, dueDate])
}

model StoreFollowUpSettings {
  storeId          String  @id
  birthdayLeadDays Int     @default(0)
  warrantyMonths   Int     @default(12)
  warrantyLeadDays Int     @default(7)
  inactiveDays     Int     @default(90)
  includeDebts     Boolean @default(true)
  store            Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
}

// Suppliers and the stock lots bought from them. Soft-deleted rows stay for the audit.
model Supplier {
  id        String    @id @default(cuid())
  storeId   String
  name      String    @db.VarChar(120)
  phone     String?   @db.VarChar(50)
  email     String?   @db.VarChar(255)
  notes     String?   @db.Text
  deletedAt DateTime?
  deletedBy String?   @db.VarChar(255)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  store     Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  purchases StockPurchase[]
  items     InventoryItem[]
  returnCases ReturnCase[]

  @@index([storeId, deletedAt])
  @@index([storeId, name])
}

model StockPurchase {
  id          String    @id @default(cuid())
  storeId     String
  supplierId  String
  name        String?   @db.VarChar(120)
  purchasedAt DateTime
  notes       String?   @db.Text
  deletedAt   DateTime?
  deletedBy   String?   @db.VarChar(255)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  store       Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  supplier    Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  items       InventoryItem[]

  @@index([storeId, deletedAt, purchasedAt])
  @@index([supplierId])
}

// Operating expenses. They are not cash-register movements: transfers and balance
// adjustments stay out of profit. Soft-deleted rows stay in the table.
model Expense {
  id           String    @id @default(cuid())
  storeId      String
  spentAt      DateTime
  category     String    @db.VarChar(80)
  amount       Decimal   @db.Decimal(12, 2)
  currency     String    @db.VarChar(3)
  exchangeRate Decimal?  @db.Decimal(12, 2)
  notes        String?   @db.Text
  deletedAt    DateTime?
  deletedBy    String?   @db.VarChar(255)
  createdBy    String?   @db.VarChar(255)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  store        Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, deletedAt, spentAt])
}

// A claim opened from a completed sale. Soft-deleted rows stay. Uniqueness lives only on this new table.
model ReturnCase {
  id              String    @id @default(cuid())
  storeId         String
  caseNumber      Int
  saleId          String?
  clientId        String?
  clientName      String    @default("") @db.VarChar(120)
  inventoryItemId String?
  imei            String    @default("") @db.VarChar(100)
  deviceLabel     String    @default("") @db.VarChar(160)
  supplierId      String?
  reason          String    @db.Text
  diagnosis       String?   @db.Text
  openedAt        DateTime
  resolution      String?   @db.VarChar(20)
  settlement      String?   @db.VarChar(20)
  moneyAmount     Decimal   @default(0) @db.Decimal(12, 2)
  moneyCurrency   String?   @db.VarChar(3)
  destination     String?   @db.VarChar(20)
  stockStatus     String?   @db.VarChar(20)
  previousStatus  String?   @db.VarChar(20)
  rmaStatus       String?   @db.VarChar(20)
  status          String    @default("ABIERTO") @db.VarChar(20)
  resolvedAt      DateTime?
  deletedAt       DateTime?
  deletedBy       String?   @db.VarChar(255)
  createdBy       String?   @db.VarChar(255)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  store           Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  sale            Sale?     @relation(fields: [saleId], references: [id], onDelete: SetNull)
  client          Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)
  supplier        Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  events          ReturnEvent[]
  creditNote      CreditNote?

  @@unique([storeId, caseNumber])
  @@index([storeId, deletedAt, openedAt])
  @@index([saleId])
  @@index([clientId])
  @@index([supplierId])
}

model ReturnEvent {
  id         String     @id @default(cuid())
  storeId    String
  caseId     String
  status     String     @db.VarChar(20)
  note       String?    @db.VarChar(280)
  createdAt  DateTime   @default(now())
  returnCase ReturnCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([storeId, caseId, createdAt])
}

// Balance the client can spend on a later sale. Applying it never creates a second cash collection.
model CreditNote {
  id           String    @id @default(cuid())
  storeId      String
  clientId     String
  returnCaseId String    @unique
  saleId       String?
  amount       Decimal   @db.Decimal(12, 2)
  remaining    Decimal   @db.Decimal(12, 2)
  currency     String    @db.VarChar(3)
  status       String    @default("ABIERTA") @db.VarChar(20)
  deletedAt    DateTime?
  deletedBy    String?   @db.VarChar(255)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  store        Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  client       Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  returnCase   ReturnCase @relation(fields: [returnCaseId], references: [id], onDelete: Cascade)
  applications CreditNoteApplication[]

  @@index([storeId, clientId, status])
  @@index([saleId])
}

model CreditNoteApplication {
  id           String     @id @default(cuid())
  storeId      String
  creditNoteId String
  saleId       String?
  amount       Decimal    @db.Decimal(12, 2)
  currency     String     @db.VarChar(3)
  appliedAt    DateTime   @default(now())
  store        Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  creditNote   CreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)
  sale         Sale?      @relation(fields: [saleId], references: [id], onDelete: SetNull)

  @@index([storeId, saleId])
  @@index([creditNoteId])
}

// Opt-in audit mail. One row per store; absent means off. No uniqueness added to existing tables.
model PeriodicReportSettings {
  storeId       String    @id
  enabled       Boolean   @default(false)
  frequency     String    @default("MONTHLY") @db.VarChar(16)
  recipients    String    @default("") @db.Text
  sendDay       Int       @default(1)
  sendTime      String    @default("09:00") @db.VarChar(5)
  lastTestAt    DateTime?
  lastPeriodKey String?   @db.VarChar(40)
  lastSentAt    DateTime?
  lastError     String?   @db.VarChar(280)
  store         Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
}

// SMTP outbox: stable payload, claim before transport, no automatic ambiguous retry.
model PeriodicReportDelivery {
  id          String   @id @default(cuid())
  storeId     String
  periodKey   String   @db.VarChar(40)
  recipient   String   @db.VarChar(255)
  status      String   @default("PREPARED") @db.VarChar(20)
  attempts    Int      @default(0)
  subject     String   @db.Text
  html        String   @db.Text
  text        String   @db.Text
  providerId  String?  @db.VarChar(255)
  sentAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, periodKey, recipient])
  @@index([storeId])
}

// Daily cash ledger: original currency, no relation to deletable sale/payment rows.
model CashRegister {
  id        String @id @default(cuid())
  storeId   String
  name      String @db.VarChar(120)
  currency  String @db.VarChar(3)
  method    String @db.VarChar(20)
  balance   Decimal @default(0) @db.Decimal(12, 2)
  isDefault Boolean @default(false)
  archivedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  store     Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  sessions  CashSession[]
  movements CashMovement[]
  @@index([storeId])
  @@index([storeId, currency, method])
}

model CashSession {
  id           String @id @default(cuid())
  storeId      String
  registerId   String
  day          String @db.VarChar(10)
  status       String @default("OPEN") @db.VarChar(20)
  opening      Decimal @db.Decimal(12, 2)
  openedBy     String
  approvedBy   String?
  reviewNote   String? @db.VarChar(500)
  openedAt     DateTime @default(now())
  approvedAt   DateTime?
  store        Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  register     CashRegister @relation(fields: [registerId], references: [id], onDelete: Restrict)
  movements    CashMovement[]
  counts       CashCount[]
  @@index([storeId])
  @@unique([registerId, day])
}

model CashMovement {
  id            String @id @default(cuid())
  storeId       String
  registerId    String?
  sessionId     String?
  currency      String? @db.VarChar(3)
  method        String? @db.VarChar(30)
  amount        Decimal @db.Decimal(12, 2)
  kind          String @db.VarChar(20)
  category      String? @db.VarChar(80)
  note          String? @db.VarChar(500)
  sourceType    String? @db.VarChar(30)
  sourceId      String?
  requestKey    String?
  transferGroup String?
  exchangeRate  Decimal? @db.Decimal(12, 2)
  reversalOf    String? @unique
  voidedAt      DateTime?
  createdBy     String?
  createdAt     DateTime @default(now())
  store         Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  register      CashRegister? @relation(fields: [registerId], references: [id], onDelete: Restrict)
  session       CashSession? @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  @@index([storeId])
  @@index([storeId, registerId, createdAt])
  @@index([storeId, sourceType, sourceId])
  @@unique([storeId, requestKey])
}

model CashCount {
  id          String @id @default(cuid())
  storeId     String
  sessionId   String
  expected    Decimal @db.Decimal(12, 2)
  counted     Decimal @db.Decimal(12, 2)
  difference  Decimal @db.Decimal(12, 2)
  denominations Json?
  note        String? @db.VarChar(500)
  countedBy   String
  createdAt   DateTime @default(now())
  store       Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  session     CashSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  @@index([storeId])
  @@index([sessionId, createdAt])
}

// Global provider catalog, not a tenant business dataset. Uniqueness only on new tables.
model BillingPlan {
  key         String   @id @db.VarChar(32)
  providerId  String   @unique @db.VarChar(100)
  sellerId    String   @db.VarChar(100)
  initPoint   String   @db.Text
  amountArs   Decimal  @db.Decimal(12, 2)
  exchangeRate Decimal @db.Decimal(12, 2)
  updatedAt   DateTime @updatedAt
}

model BillingCheckout {
  id         String   @id @default(cuid())
  storeId    String
  planKey    String   @db.VarChar(32)
  providerPlanId String @db.VarChar(100)
  payerEmail String   @db.VarChar(255)
  amountArs  Decimal  @db.Decimal(12, 2)
  exchangeRate Decimal @db.Decimal(12, 2)
  expiresAt  DateTime
  openedAt   DateTime?
  checkoutStatus String @default("QUOTED") @db.VarChar(20)
  providerSubscriptionId String? @db.VarChar(100)
  /// Last preapproval status Mercado Pago reported. `cancelled` on a new attempt is a rejected card.
  providerStatus String? @db.VarChar(20)
  createdAt  DateTime @default(now())
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
}

model ProductEvent {
  id        String   @id @default(cuid())
  name      String   @db.VarChar(48)
  storeId   String?
  userId    String?
  source    String   @db.VarChar(8)
  props     Json?
  dedupeKey String?  @unique @db.VarChar(160)
  clientAt  DateTime?
  createdAt DateTime @default(now())
  store     Store?   @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([name, createdAt])
  @@index([storeId, createdAt])
  @@index([userId, createdAt])
}

// Blind physical count. New tables only: no unique constraints on existing models.
model StockCount {
  id             String    @id @default(cuid())
  storeId        String
  status         String    @default("OPEN") @db.VarChar(16)
  scope          String    @default("DEVICES") @db.VarChar(16)
  startedById    String
  startedByName  String    @db.VarChar(255)
  closedById     String?
  closedByName   String?   @db.VarChar(255)
  closedAt       DateTime?
  resolution     String?   @db.VarChar(16)
  excludedNoImei Int       @default(0)
  result         Json?
  store          Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  expected       StockCountExpected[]
  scans          StockCountScan[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([storeId, status])
  @@index([storeId, createdAt])
}

model StockCountExpected {
  id               String     @id @default(cuid())
  stockCountId     String
  storeId          String
  inventoryItemId  String
  imei             String     @db.VarChar(32)
  model            String     @db.VarChar(100)
  capacity         String     @db.VarChar(50)
  color            String     @db.VarChar(50)
  statusAtSnapshot String     @db.VarChar(20)
  price            Decimal?   @db.Decimal(12, 2)
  currency         String?    @db.VarChar(3)
  stockCount       StockCount @relation(fields: [stockCountId], references: [id], onDelete: Cascade)
  createdAt        DateTime   @default(now())

  @@index([stockCountId])
  @@index([storeId, stockCountId])
  @@index([stockCountId, imei])
}

model StockCountScan {
  id              String     @id @default(cuid())
  stockCountId    String
  storeId         String
  scannedById     String
  scannedByName   String     @db.VarChar(255)
  imei            String     @db.VarChar(32)
  result          String     @db.VarChar(16)
  counts          Boolean    @default(true)
  inventoryItemId String?
  model           String?    @db.VarChar(100)
  capacity        String?    @db.VarChar(50)
  color           String?    @db.VarChar(50)
  stockCount      StockCount @relation(fields: [stockCountId], references: [id], onDelete: Cascade)
  createdAt       DateTime   @default(now())

  @@index([stockCountId, scannedById, createdAt])
  @@index([stockCountId, imei])
  @@index([storeId, stockCountId])
}

// Read receipts track exact row versions; acknowledging a visit never consumes a later edit.
model SectionRecordView {
  storeId       String
  userId        String
  section       String   @db.VarChar(30)
  recordId      String
  seenUpdatedAt DateTime
  store         Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([storeId, userId, section, recordId])
  @@index([storeId])
  @@index([userId])
}

model ImeiTacMiss {
  tac         String   @id @db.VarChar(8)
  count       Int      @default(1)
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now()) @updatedAt

  @@map("ImeiTacMiss")
}
