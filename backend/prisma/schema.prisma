generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String        @id @default(cuid())
  firebaseUid       String        @unique
  email             String?       @db.VarChar(255)
  displayName       String?       @db.VarChar(255)
  avatarUrl         String?       @db.Text
  status            UserStatus    @default(ACTIVE)
  twoFactorEnabled  Boolean       @default(false)
  twoFactorCode     String?       @db.VarChar(6)
  twoFactorExpiry   DateTime?
  memberships       StoreMember[]
  notificationReads NotificationRead[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model Store {
  id                  String               @id @default(cuid())
  name                String               @db.VarChar(120)
  legalName           String?              @db.VarChar(160)
  taxId               String?              @db.VarChar(50)
  phone               String?              @db.VarChar(50)
  email               String?              @db.VarChar(255)
  instagram           String?              @db.VarChar(60)
  address             String?              @db.VarChar(255)
  currency            String               @default("ARS") @db.VarChar(10)
  timezone            String               @default("America/Argentina/Buenos_Aires") @db.VarChar(80)
  memberships         StoreMember[]
  invitations         StoreInvitation[]
  clients             Client[]
  clientCategories    ClientCategory[]
  inventory           InventoryItem[]
  inventoryCategories InventoryCategory[]
  saleCategories      SaleCategory[]
  sales               Sale[]
  tradeIns            TradeIn[]
  tradeInCategories   TradeInCategory[]
  catalogOptions      StoreCatalogOption[]
  clientPayments      ClientPayment[]
  notifications       StoreNotification[]
  accessories         Accessory[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model StoreMember {
  id        String    @id @default(cuid())
  storeId   String
  userId    String
  role      StoreRole
  isDefault Boolean   @default(false)
  sections  Json?
  store     Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([storeId, userId])
}

model Client {
  id             String          @id @default(cuid())
  storeId        String
  categoryId     String?
  dni            String?         @db.VarChar(50)
  name           String          @db.VarChar(120)
  email          String?         @db.VarChar(255)
  phone          String?         @db.VarChar(50)
  lastPurchaseAt DateTime?
  totalSpent     Decimal         @default(0) @db.Decimal(12, 2)
  pendingBalance Decimal         @default(0) @db.Decimal(12, 2)
  tag            String?         @db.VarChar(30)
  customFields   Json?
  store          Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category       ClientCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  sales          Sale[]
  tradeIns       TradeIn[]
  payments       ClientPayment[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([storeId])
  @@unique([storeId, dni])
}

model ClientCategory {
  id        String   @id @default(cuid())
  storeId   String
  name      String   @db.VarChar(80)
  sortOrder Int      @default(0)
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  clients   Client[]
  createdAt DateTime @default(now())

  @@index([storeId])
  @@unique([storeId, name])
}

model InventoryCategory {
  id        String          @id @default(cuid())
  storeId   String
  name      String          @db.VarChar(80)
  sortOrder Int             @default(0)
  store     Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  items     InventoryItem[]
  createdAt DateTime        @default(now())

  @@index([storeId])
  @@unique([storeId, name])
}

model InventoryItem {
  id            String             @id @default(cuid())
  storeId       String
  categoryId    String?
  imei          String?            @db.VarChar(100)
  model         String             @db.VarChar(100)
  capacity      String             @db.VarChar(50)
  color         String             @db.VarChar(50)
  condition     String             @db.VarChar(20)
  grade         String             @db.VarChar(20)
  batteryHealth String             @db.VarChar(50)
  cost          Decimal            @db.Decimal(12, 2)
  price         Decimal            @db.Decimal(12, 2)
  // The desk UI no longer edits quantity, but production rows still store it.
  quantity      Int                @default(1)
  status        String             @db.VarChar(20)
  archivedAt    DateTime?
  pendingSaleRegistration Boolean  @default(false)
  previousSaleStatus String?       @db.VarChar(20)
  customFields  Json?
  store         Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category      InventoryCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  sales         Sale[]
  receivedTradeIns TradeIn[]       @relation("ReceivedInventory")
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([storeId])
  @@unique([storeId, imei])
}

model Sale {
  id              String         @id @default(cuid())
  saleNumber      Int            @default(autoincrement())
  storeId         String
  clientId        String?
  clientName      String         @default("") @db.VarChar(120)
  categoryId      String?
  inventoryItemId String?
  tradeInId       String?        @unique
  requestKey      String?        @db.VarChar(120)
  integratedOperation Boolean    @default(false)
  previousInventoryStatus String? @db.VarChar(20)
  previousPendingSaleRegistration Boolean?
  deviceLabel     String?        @db.VarChar(120)
  dateLabel       String         @db.VarChar(120)
  amount          Decimal        @db.Decimal(12, 2)
  paymentMethod   String         @db.VarChar(50)
  status          String         @db.VarChar(20)
  customFields    Json?
  soldAt          DateTime
  store           Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  client          Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  category        SaleCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)
  tradeIn         TradeIn?       @relation(fields: [tradeInId], references: [id], onDelete: SetNull)
  accessoryLines  SaleAccessory[]
  accessoryMovements AccessoryMovement[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([storeId])
  @@index([storeId, soldAt])
  @@index([clientId])
  @@index([inventoryItemId])
  @@unique([storeId, requestKey])
}

model TradeIn {
  id                 String           @id @default(cuid())
  tradeNumber        Int              @default(autoincrement())
  storeId            String
  clientId           String?
  clientName         String           @default("") @db.VarChar(120)
  categoryId         String?
  dateLabel          String           @db.VarChar(120)
  deviceReceived     String           @db.VarChar(120)
  deviceReceivedImei String?          @db.VarChar(100)
  takeValue          Decimal          @db.Decimal(12, 2)
  deviceGiven        String           @default("") @db.VarChar(120)
  differencePaid     Decimal          @db.Decimal(12, 2)
  status             String           @db.VarChar(30)
  batteryHealth      String?          @db.VarChar(50)
  grade              String?          @db.VarChar(20)
  confirmationStatus TradeInConfirmationStatus?
  receivedInventoryItemId String?
  previousOutgoingStatus String?      @db.VarChar(20)
  previousOutgoingPendingRegistration Boolean?
  requestKey         String?          @db.VarChar(120)
  operationSource    String?          @db.VarChar(20)
  draftProductId     String?          @db.VarChar(120)
  draftDeviceLabel   String?          @db.VarChar(120)
  draftSaleCategoryId String?         @db.VarChar(120)
  draftAmount        Decimal?         @db.Decimal(12, 2)
  draftPaymentMethod String?          @db.VarChar(50)
  draftPaymentStatus String?          @db.VarChar(20)
  customFields       Json?
  tradeAt            DateTime
  store              Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  client             Client?          @relation(fields: [clientId], references: [id], onDelete: SetNull)
  category           TradeInCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  receivedInventoryItem InventoryItem? @relation("ReceivedInventory", fields: [receivedInventoryItemId], references: [id], onDelete: SetNull)
  sale               Sale?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([storeId])
  @@index([storeId, tradeAt])
  @@index([clientId])
  @@unique([storeId, requestKey])
}

enum TradeInConfirmationStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model StoreNotification {
  id        String   @id @default(cuid())
  storeId   String
  section   String   @db.VarChar(30)
  title     String   @db.VarChar(160)
  message   String   @db.Text
  recordId  String?  @db.VarChar(120)
  kind      String   @db.VarChar(40)
  createdAt DateTime @default(now())
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  reads     NotificationRead[]

  @@index([storeId, section, createdAt])
}

model NotificationRead {
  id             String            @id @default(cuid())
  notificationId String
  userId         String
  readAt         DateTime           @default(now())
  notification   StoreNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@index([userId])
}

model TradeInCategory {
  id        String    @id @default(cuid())
  storeId   String
  name      String    @db.VarChar(80)
  sortOrder Int       @default(0)
  store     Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  tradeIns  TradeIn[]
  createdAt DateTime  @default(now())

  @@index([storeId])
  @@unique([storeId, name])
}

model SaleCategory {
  id        String   @id @default(cuid())
  storeId   String
  name      String   @db.VarChar(80)
  sortOrder Int      @default(0)
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  sales     Sale[]
  createdAt DateTime @default(now())

  @@index([storeId])
  @@unique([storeId, name])
}

enum CatalogKind {
  INVENTORY_STATUS
  INVENTORY_CAPACITY
  INVENTORY_CONDITION
  SALE_STATUS
  TRADE_IN_STATUS
  CLIENT_TAG
}

model ClientPayment {
  id        String   @id @default(cuid())
  storeId   String
  clientId  String
  amount    Decimal  @db.Decimal(12, 2)
  method    String   @db.VarChar(50)
  paidAt    DateTime @default(now())
  note      String?  @db.VarChar(200)
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([storeId])
  @@index([clientId])
}

model StoreCatalogOption {
  id        String      @id @default(cuid())
  storeId   String
  kind      CatalogKind
  value     String      @db.VarChar(30)
  label     String      @db.VarChar(20)
  color     String?     @db.VarChar(9)
  isSystem  Boolean     @default(false)
  sortOrder Int         @default(0)
  store     Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([storeId, kind, value])
  @@index([storeId, kind])
}

model StoreInvitation {
  id        String           @id @default(cuid())
  storeId   String
  token     String           @unique @default(uuid())
  email     String?          @db.VarChar(255)
  role      StoreRole
  status    InvitationStatus @default(PENDING)
  expiresAt DateTime
  store     Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([storeId])
  @@index([token])
}

model Accessory {
  id             String               @id @default(cuid())
  storeId        String
  name           String               @db.VarChar(160)
  category       String               @db.VarChar(40)
  compatibleWith String               @default("") @db.VarChar(160)
  sku            String               @default("") @db.VarChar(40)
  cost           Decimal              @default(0) @db.Decimal(12, 2)
  price          Decimal              @default(0) @db.Decimal(12, 2)
  stock          Int                  @default(0)
  minStock       Int                  @default(0)
  store          Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  movements      AccessoryMovement[]
  saleLines      SaleAccessory[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([storeId])
  @@index([storeId, category])
}

model AccessoryMovement {
  id          String    @id @default(cuid())
  storeId     String
  accessoryId String
  delta       Int
  kind        String    @db.VarChar(20)
  note        String    @default("") @db.VarChar(160)
  saleId      String?
  accessory   Accessory @relation(fields: [accessoryId], references: [id], onDelete: Cascade)
  sale        Sale?     @relation(fields: [saleId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())

  @@index([storeId])
  @@index([accessoryId, createdAt])
  @@index([saleId])
}

model SaleAccessory {
  id          String    @id @default(cuid())
  storeId     String
  saleId      String
  accessoryId String
  name        String    @db.VarChar(160)
  quantity    Int
  unitPrice   Decimal   @db.Decimal(12, 2)
  voidedAt    DateTime?
  accessory   Accessory @relation(fields: [accessoryId], references: [id], onDelete: Restrict)
  sale        Sale      @relation(fields: [saleId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@index([storeId])
  @@index([saleId])
  @@index([accessoryId])
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum StoreRole {
  OWNER
  MANAGER @map("ADMIN")
  STAFF   @map("SELLER")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}

